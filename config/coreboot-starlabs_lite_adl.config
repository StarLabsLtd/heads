CONFIG_VENDOR_STARLABS=y
CONFIG_BOARD_STARLABS_LITE_ADL=y
CONFIG_HAVE_IFD_BIN=y
CONFIG_HAVE_ME_BIN=y
CONFIG_EC_STARLABS_ADD_ITE_BIN=y
CONFIG_MAINBOARD_SERIAL_NUMBER="I500000"
CONFIG_SBOM=y
CONFIG_SMMSTORE=y
CONFIG_TPM_MEASURED_BOOT=y
CONFIG_LOCK_MANAGEMENT_ENGINE=y
CONFIG_CBFS_SIZE=0x400000
CONFIG_IFD_CHIPSET="adl"
CONFIG_POST_IO=n
CONFIG_FSP_TYPE_IOT=y
CONFIG_FSP_USE_REPO=y
CONFIG_PAYLOAD_LINUX=y
CONFIG_PAYLOAD_FILE="@BOARD_BUILD_DIR@/bzImage"
CONFIG_LINUX_INITRD="@BOARD_BUILD_DIR@/initrd.cpio.xz"
