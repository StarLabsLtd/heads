# Build-analysis targets must retain the compact Intel runtime without exposing
# an internal update command for layouts that cannot yet contain Heads.
include $(pwd)/boards/starlabs/compact-intel.config

CONFIG_FLASH_OPTIONS :=
CONFIG_FLASH_READ_OPTIONS :=
unexport CONFIG_FLASH_OPTIONS CONFIG_FLASH_READ_OPTIONS
export CONFIG_CBFS_VIA_FLASHPROG=n
